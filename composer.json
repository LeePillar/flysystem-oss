{
    "name": "apixx/flysystem-oss",
    "description": "Flysystem adapter for Aliyun OSS storage, PHP 8.0 - 8.5 compatible",
    "type": "library",
    "keywords": [
        "thinkphp",
        "flysystem",
        "oss",
        "alioss",
        "aliyun",
        "阿里oss"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "iidestiny",
            "email": "iidestiny@vip.qq.com"
        }
    ],
    "require": {
        "php": ">=8.0",
        "topthink/framework": "^6.1 || ^8.0",
        "ext-openssl": "*",
        "ext-curl": "*",
        "ext-json": "*",
        "league/flysystem": "^3.0",
        "aliyuncs/oss-sdk-php": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "apixx\\Oss\\": "src"
        }
    },
    "require-dev": {
        "mockery/mockery": "^1.5",
        "phpunit/phpunit": "^9.5",
        "symfony/var-dumper": "^3.4"
    }
}
